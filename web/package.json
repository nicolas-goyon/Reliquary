    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "4.14.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.91.0",
