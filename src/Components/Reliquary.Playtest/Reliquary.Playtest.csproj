<Project Sdk="Microsoft.NET.Sdk">
  <!-- Core component. Reference Reliquary.BuildingBlocks only, never another core component. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The game tokens (JSON Web Tokens). The Accounts component uses the same package for the access tokens: no new package. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Reliquary.BuildingBlocks\Reliquary.BuildingBlocks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Reliquary.Playtest.Tests" />
  </ItemGroup>
</Project>
