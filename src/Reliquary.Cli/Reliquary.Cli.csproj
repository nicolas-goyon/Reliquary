<Project Sdk="Microsoft.NET.Sdk">
  <!-- The command line tool for the administrators of an instance. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>reliquary</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reliquary.Hosting\Reliquary.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
