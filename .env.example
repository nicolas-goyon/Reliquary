# Settings of the local instance. Copy this file to .env, then change the values.
# The justfile and Docker Compose read the .env file.

# Name of the instance. Give each instance a different name and different ports
# to run several instances at the same time.
RELIQUARY_INSTANCE=dev

# Ports on your computer.
RELIQUARY_POSTGRES_PORT=15432
RELIQUARY_REDIS_PORT=16379
RELIQUARY_SMTP_PORT=11025
RELIQUARY_MAILPIT_PORT=18025
RELIQUARY_APP_PORT=8080
RELIQUARY_WEB_PORT=5173
RELIQUARY_GRAFANA_PORT=3000
RELIQUARY_OTLP_GRPC_PORT=4317
RELIQUARY_OTLP_HTTP_PORT=4318

# Password of the local database. Use it for local development only.
RELIQUARY_POSTGRES_PASSWORD=reliquary

# The key that signs the access tokens of the local instance: 32 random bytes or more, in base64.
# Make a new key with: openssl rand -base64 32
RELIQUARY_SIGNING_KEY=bG9jYWwtaW5zdGFuY2Utb25seS1kby1ub3QtdXNlLWluLXByb2R1Y3Rpb24=

# The folder of the card data that the local instance imports. The default is the demo dataset.
RELIQUARY_CARD_DATA=./data/demo

# Set to true to get card recommendations from recommander.cards on the deck page.
# The terms of recommander.cards allow personal, non-commercial use. See docs/decisions/0028-card-recommendations-source.md.
RELIQUARY_RECOMMENDATIONS=false
