# Settings of the local instance. Copy this file to .env, then change the values.
# The justfile and Docker Compose read the .env file.

# Name of the instance. Give each instance a different name and different ports
# to run several instances at the same time.
RELIQUARY_INSTANCE=dev

# Ports on your computer.
RELIQUARY_POSTGRES_PORT=15432
RELIQUARY_REDIS_PORT=16379
RELIQUARY_APP_PORT=8080
RELIQUARY_WEB_PORT=5173
RELIQUARY_GRAFANA_PORT=3000
RELIQUARY_OTLP_GRPC_PORT=4317
RELIQUARY_OTLP_HTTP_PORT=4318

# Password of the local database. Use it for local development only.
RELIQUARY_POSTGRES_PASSWORD=reliquary

# The key that signs the access tokens of the local instance: 32 random bytes or more, in base64.
# Make a new key with: openssl rand -base64 32
RELIQUARY_SIGNING_KEY=bG9jYWwtaW5zdGFuY2Utb25seS1kby1ub3QtdXNlLWluLXByb2R1Y3Rpb24=

# The development sign-in: a user opens an account with an email address, with no OAuth provider and no password.
# Use it on a development instance only: all the persons who can reach the instance can open all its accounts.
RELIQUARY_DEVELOPMENT_SIGN_IN=true

# The sign-in with Google, GitHub and Discord. The button of a service shows when its two values are set.
# Google: make an OAuth client at https://console.cloud.google.com/apis/credentials.
# GitHub: make an OAuth app at https://github.com/settings/developers.
# Discord: make an application at https://discord.com/developers/applications.
# The authorized redirect URI is http://localhost:8080/api/v1/auth/external/<service>/callback, with google, github or discord.
RELIQUARY_GOOGLE_CLIENT_ID=
RELIQUARY_GOOGLE_CLIENT_SECRET=
RELIQUARY_GITHUB_CLIENT_ID=
RELIQUARY_GITHUB_CLIENT_SECRET=
RELIQUARY_DISCORD_CLIENT_ID=
RELIQUARY_DISCORD_CLIENT_SECRET=

# The user agent that Moxfield support allows. Without it, the import from a Moxfield link is not available.
# The import from an Archidekt link needs no setting.
RELIQUARY_MOXFIELD_USER_AGENT=

# The folder of the card data that the local instance imports. The default is the demo dataset.
# The demo dataset has 342 cards only. An imported deck can contain other cards.
RELIQUARY_CARD_DATA=./data/demo

# To use all the cards, set this value to nothing, then run: just full-cards
# RELIQUARY_CARD_IMPORT_DIRECTORY=

# The card file of Scryfall for the full import: default_cards or all_cards.
RELIQUARY_CARD_BULK_TYPE=default_cards

# Set to true to get card recommendations from recommander.cards on the deck page.
# The terms of recommander.cards allow personal, non-commercial use. See docs/decisions/0028-card-recommendations-source.md.
RELIQUARY_RECOMMENDATIONS=false
