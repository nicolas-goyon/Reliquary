# Settings of a deployed instance of Reliquary (for example the pre-production instance).
# Copy this file to .env in the folder of the script reliquary-update, then change the values.
# Keep the .env file private: it contains the secrets of the instance.

# The version of the images: "develop" (the last build of the develop branch),
# "latest" (the last release) or a release number, for example "0.2.0".
# "reliquary-update VERSION" uses VERSION. "reliquary-update" with no argument uses this value.
RELIQUARY_VERSION=develop

# The name of the Docker Compose project. It is also the prefix of the volume names.
# Do not use the name of a development instance (reliquary-dev).
RELIQUARY_PROJECT=reliquary-preprod

# The address and the ports on your computer. Use 0.0.0.0 to open the instance to the other devices of your network.
RELIQUARY_BIND_ADDRESS=127.0.0.1
RELIQUARY_APP_PORT=8090
RELIQUARY_MAILPIT_PORT=18035

# The URL that the users open. The emails and the external sign-in use it.
RELIQUARY_PUBLIC_URL=http://localhost:8090

# Required. The password of the database. Make a value with: openssl rand -base64 24
RELIQUARY_POSTGRES_PASSWORD=

# Required. The key that signs the access tokens: 32 random bytes or more, in base64.
# Make a key with: openssl rand -base64 32
# When you change the key, all the users must sign in again.
RELIQUARY_SIGNING_KEY=

# The email address of the administrator. This account can open /admin/moderation.
RELIQUARY_ADMINISTRATOR_EMAIL=

# Set to true to let users make an account with no email address.
RELIQUARY_ACCOUNTS_WITHOUT_EMAIL=false

# Set to true to make users open an email link before the first sign-in.
RELIQUARY_REQUIRE_CHECKED_EMAIL=false

# The email server. The default is the test server Mailpit: read the emails at http://localhost:18035.
RELIQUARY_SMTP_HOST=mailpit
RELIQUARY_SMTP_PORT=1025
# The TLS mode: Auto, None, StartTls or SslOnConnect.
RELIQUARY_SMTP_SECURITY=None
RELIQUARY_SMTP_USER_NAME=
RELIQUARY_SMTP_PASSWORD=
RELIQUARY_EMAIL_FROM=Reliquary <noreply@reliquary.localhost>

# The Google sign-in. The authorized redirect URI is RELIQUARY_PUBLIC_URL/api/v1/auth/external/google/callback.
RELIQUARY_GOOGLE_CLIENT_ID=
RELIQUARY_GOOGLE_CLIENT_SECRET=

# The user agent that Moxfield support allows. Without it, the import from a Moxfield link is not available.
RELIQUARY_MOXFIELD_USER_AGENT=

# The card file of Scryfall: default_cards (one printing in each language) or all_cards.
RELIQUARY_CARD_BULK_TYPE=default_cards

# Set to true to show the card recommendations.
RELIQUARY_RECOMMENDATIONS=false

# The folder of the backups. The script makes a backup before each update.
RELIQUARY_BACKUP_DIRECTORY=./backups

# The number of backups that the script keeps. It deletes the older backups.
RELIQUARY_KEEP_BACKUPS=10

# The prefix of the image names. Change it only to use images from a different registry.
RELIQUARY_IMAGE_PREFIX=ghcr.io/nicolas-goyon/reliquary
